# ── Local development (default) ──────────────────────────────────────────────
# SQLite database file (relative to the prisma/ directory).
# `npm run dev` auto-creates and seeds it on first run.
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs — use a long random string in production:
#   openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Vercel / production (Postgres, e.g. Supabase or Neon) ────────────────────
# 1. Run: npm run use:postgres   (switches Prisma provider to postgresql)
# 2. Set DATABASE_URL to your pooled connection string, e.g. Supabase:
#    postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# 3. One-time, from your machine, create tables + demo data using the DIRECT
#    (port 5432) connection string:
#    DATABASE_URL="postgresql://...:5432/postgres" npx prisma db push
#    DATABASE_URL="postgresql://...:5432/postgres" npx prisma db seed
# 4. In Vercel → Project → Settings → Environment Variables, set:
#    DATABASE_URL  (pooled string from step 2)
#    AUTH_SECRET   (openssl rand -hex 32)
